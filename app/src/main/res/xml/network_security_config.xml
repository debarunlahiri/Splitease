<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed only for the local development backend; everything else needs https. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The Mac running the backend on the local Wi-Fi (real phone). -->
        <domain includeSubdomains="false">192.168.0.135</domain>
        <!-- The same Mac as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">api.lambrk.com</domain>
    </domain-config>
</network-security-config>
